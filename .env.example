# Copia in .env e riempi. .env è ignorato da git — le chiavi non entrano mai nel repo.
# Se non metti nessuna chiave, il prototipo usa la voce `say` di macOS.

# Cartesia ha la precedenza se presente.  https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# voci italiane disponibili:  node proto/check-cartesia.mjs
CARTESIA_VOICE_ID=c8403b5c-6465-4396-9065-a440d376528a

# https://elevenlabs.io/app/api/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
